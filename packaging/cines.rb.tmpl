# Template for the Homebrew cask. The release workflow fills in the version and
# the disk image checksum, then pushes the result to sanketsudake/homebrew-tap.
# The placeholders are not named here on purpose: the workflow substitutes them
# globally, so naming one turns this comment into nonsense.
#
# One url rather than on_intel/on_arm blocks, because the disk image holds a
# universal binary.
cask "cines" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/sanketsudake/CHESS-in-Qt/releases/download/v#{version}/CINES-#{version}-macos-universal.dmg"
  name "CINES"
  desc "Two player chess"
  homepage "https://github.com/sanketsudake/CHESS-in-Qt"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :monterey

  app "CINES.app"

  # The disk image is not signed with an Apple Developer ID, so macOS files it
  # under quarantine and refuses to open it. Homebrew installs are explicit
  # enough to clear that; a direct download is not, which is why the release
  # notes tell those users to right-click and Open instead.
  #
  # must_succeed: false keeps the old `system_command` tolerance -- xattr exits
  # non-zero when the path is missing, and that should not fail an install.
  postflight_steps do
    run "/usr/bin/xattr",
        args:         ["-dr", "com.apple.quarantine", "{{appdir}}/CINES.app"],
        must_succeed: false
  end

  zap trash: [
    "~/Library/Preferences/io.github.sanketsudake.cines.plist",
    "~/Library/Saved Application State/io.github.sanketsudake.cines.savedState",
  ]
end
