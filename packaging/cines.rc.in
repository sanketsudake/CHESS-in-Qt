// Windows resource script, generated by CMake so the version shown in the
// executable's properties is the one the build was given.
//
// @VERSION@ style substitution happens at configure time; the icon path is
// relative to this file's configured location in the build directory.
IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/packaging/cines.ico"

1 VERSIONINFO
FILEVERSION @CINES_VERSION_COMMAS@
PRODUCTVERSION @CINES_VERSION_COMMAS@
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CINES"
            VALUE "FileVersion", "@CINES_VERSION@"
            VALUE "InternalName", "cines"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "cines.exe"
            VALUE "ProductName", "CINES"
            VALUE "ProductVersion", "@CINES_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
